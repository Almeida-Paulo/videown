# Exemplo de proxy reverso com o nginx. Troque example.com pelo seu domínio e os caminhos do certificado.
# Copie para /etc/nginx/sites-available/videown, crie o link em sites-enabled e rode:
#   sudo nginx -t && sudo systemctl reload nginx
server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com;

    ssl_certificate     /caminho/para/fullchain.pem;
    ssl_certificate_key /caminho/para/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Entrega os arquivos grandes direto, sem copiá-los para o disco do nginx antes.
        proxy_buffering off;
        proxy_request_buffering off;
        # A prévia de playlists grandes pode levar mais de um minuto.
        proxy_read_timeout 300s;
    }
}
